# Milcar platform settings. Copy this file to .env.local (never uploaded) and fill it in for your computer;
# set the same names in Vercel > Project > Settings > Environment Variables for staging and production.
# Anything starting with NEXT_PUBLIC_ is sent to every visitor's browser: only public values may use it.

# ---- Required ---------------------------------------------------------------------------------------------

# Supabase > Project Settings > API: the project address and the PUBLISHABLE key (sb_publishable_…)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# The site's own address, used in sharing links, the sitemap and emails (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase > Project Settings > API keys > Secret key (sb_secret_…). Server only. Never prefix with NEXT_PUBLIC_.
# The dashboard needs it for invitations, one-time sign-in links and rate limits; without it, the Team page says
# invitations are off and everything else works.
SUPABASE_SECRET_KEY=

# A long random value (32+ characters), e.g. from: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
# It keeps visitor counts anonymous (no cookies; a visitor is a daily hash). Without it, visits aren't recorded.
ANALYTICS_SALT=

# ---- Optional: each feature stays switched off, and says so in the dashboard, until its keys are set -----

# Email (Resend): confirmations to customers, alerts to staff. EMAIL_FROM must be on a domain verified in Resend.
RESEND_API_KEY=
EMAIL_FROM=

# Spam check on public forms (Cloudflare Turnstile)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Not part of the site yet (Settings > Connections says so): the WhatsApp Business API for automatic messages
# (the WhatsApp buttons and links work without it), Google Calendar, error tracking. Their settings come with them.
