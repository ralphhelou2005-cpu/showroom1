# Never upload secrets. The Supabase publishable key is meant to be public; the secret / service_role key,
# passwords and private keys must never be in this folder. Real values go in .env.local (never uploaded);
# .env.example lists them with no values.
.env
.env.*
!.env.example
*.local
*.key
*.pem
secrets*
service-role*

# Supabase command-line and Netlify working files, if they are ever used here
supabase/.temp/
supabase/.branches/
.netlify/

# computer and editor clutter
node_modules/
.DS_Store
Thumbs.db
desktop.ini
.vscode/
*.log

# the build's output (GitHub Actions and Vercel make it fresh on every upload)
dist/
dist-ssr/
.next/
next-env.d.ts
public/engine/
*.tsbuildinfo
.vercel/
