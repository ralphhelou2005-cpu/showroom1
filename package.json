{
  "name": "milcar",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "assets": "node scripts/assets-manifest.mjs && node scripts/build-engine.mjs",
    "dev": "npm run assets && next dev",
    "build": "npm run assets && tsc --noEmit -p tsconfig.check.json && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit -p tsconfig.check.json",
    "test:e2e": "node e2e/dashboard.e2e.ts && node e2e/inventory.e2e.ts",
    "test": "vitest run",
    "test:db": "vitest run supabase/tests"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "playwright-core": "1.64.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  }
}
